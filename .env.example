# Copy to .env and fill in
PORT=3000
NODE_ENV=production
SITE_URL=https://www.reownltd.com

# CMS login (/admin)
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-to-a-long-password
SESSION_SECRET=replace-with-a-long-random-string

# Optional: email notification for every new enquiry
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
LEADS_TO=info@reownltd.com

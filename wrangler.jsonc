// Cloudflare Workers configuration — https://developers.cloudflare.com/workers/wrangler/configuration/
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "reownltd",
  "main": "src/worker.mjs",
  "compatibility_date": "2025-09-01",

  // Precompile EJS views before every dev/deploy (Workers can't compile templates at runtime)
  "build": { "command": "node scripts/build-templates.js" },

  // CSS, JS and images in /public are served directly by Cloudflare's CDN
  "assets": { "directory": "./public" },

  // Content, leads and subscribers. No IDs needed: Wrangler creates the D1 database and
  // KV namespace automatically on the first deploy and remembers them for later deploys.
  "d1_databases": [
    { "binding": "DB", "database_name": "reown-db" }
  ],

  // Uploaded images and PDFs from the CMS media library
  "kv_namespaces": [
    { "binding": "MEDIA" }
  ],

  // Non-secret settings. Secrets (ADMIN_PASSWORD, SESSION_SECRET, RESEND_API_KEY) are set with `wrangler secret put`.
  "vars": {
    "SITE_URL": "https://www.reownltd.com",
    "ADMIN_USER": "admin",
    "LEADS_TO": "info@reownltd.com"
  },

  "observability": { "enabled": true }
}

<%- include('partials/head') %>
<%- include('partials/header') %>
<%- include('partials/page-hero', { title: sv.title, lead: sv.summary, eyebrow: 'Services', crumbs: [{ name: 'Services', url: '/#services' }, { name: sv.title }] }) %>

<section class="section">
  <div class="container detail">
    <article class="detail-main reveal">
      <div class="svc-hero-ic"><%- icon(sv.icon) %></div>
      <div class="prose"><%- md(sv.body) %></div>
      <% if (sv.features && sv.features.length) { %>
        <h2 class="h3">What’s included</h2>
        <ul class="feature-grid"><% sv.features.forEach(function(f){ %><li><%- icon('check') %><%= f %></li><% }) %></ul>
      <% } %>
      <div class="inline-cta">
        <div><h3>Need <%= sv.title.toLowerCase() %>?</h3><p>Tell us about your project and get a free consultation.</p></div>
        <button class="btn btn-orange" data-open-contact data-service="<%= sv.title %>">Discuss your project <%- icon('arrow') %></button>
      </div>
    </article>
    <aside class="detail-side">
      <div class="side-card sticky">
        <h3>All services</h3>
        <ul class="side-list">
          <% services.forEach(function(x){ %><li><a href="/services/<%= x.slug %>" class="<%= x.id===sv.id?'active':'' %>"><%- icon(x.icon) %><%= x.title %></a></li><% }) %>
        </ul>
        <button class="btn btn-primary btn-block" data-open-contact data-service="<%= sv.title %>">Get a free quote</button>
      </div>
    </aside>
  </div>
</section>

<% if (projects.length) { %>
<section class="section section-alt">
  <div class="container">
    <header class="sec-head sec-head-row reveal"><div><p class="eyebrow">Our work</p><h2 class="h2">Related case studies</h2></div><a class="btn btn-ghost" href="/portfolio">View portfolio <%- icon('arrow') %></a></header>
    <div class="pf-grid"><% projects.forEach(function(p, i){ %><%- include('partials/project-card', { p: p, i: i }) %><% }) %></div>
  </div>
</section>
<% } %>

<%- include('partials/footer') %>

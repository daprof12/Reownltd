<article class="post-card reveal" style="--d:<%= (i % 3) * 80 %>ms">
  <a href="/blog/<%= p.slug %>" class="post-link" aria-label="<%= p.title %>">
    <%- include('cover', { item: p }) %>
  </a>
  <div class="post-body">
    <p class="meta"><a href="/blog?category=<%= encodeURIComponent(p.category) %>" class="pill"><%= p.category %></a><time datetime="<%= p.publishedAt %>"><%= fmtDate(p.publishedAt) %></time><span><%= readTime(p.body) %> min read</span></p>
    <h3><a href="/blog/<%= p.slug %>"><%= p.title %></a></h3>
    <p><%= p.excerpt %></p>
    <a class="more" href="/blog/<%= p.slug %>">Read article <%- icon('arrow') %></a>
  </div>
</article>

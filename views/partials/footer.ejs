</main>

<footer class="site-footer">
  <div class="footer-glow" aria-hidden="true"></div>
  <div class="container">
    <div class="footer-cta reveal">
      <div>
        <h2>Ready to innovate, build &amp; transform?</h2>
        <p>Share your idea — get a free consultation and estimate within one business day.</p>
      </div>
      <div class="footer-cta-btns">
        <button class="btn btn-orange btn-lg" data-open-contact>Start your project <%- icon('arrow') %></button>
        <% if (s.bookingUrl) { %><a class="btn btn-ghost-light btn-lg" href="<%= s.bookingUrl %>" target="_blank" rel="noopener"><%- icon('calendar') %> Book a meeting</a><% } %>
      </div>
    </div>

    <div class="footer-grid">
      <div class="footer-about">
        <a href="/" class="brand brand-light" aria-label="<%= s.siteName %> home">
          <span class="brand-mark"><img src="/img/logo-mark.webp" alt="" width="54" height="36" loading="lazy"></span>
          <span class="brand-text"><strong>Reown</strong><small>LTD</small></span>
        </a>
        <p><%= s.footerAbout %></p>
        <% if (s.newsletter && s.newsletter.enabled) { %>
        <form class="nl-form nl-mini" novalidate>
          <input type="text" name="website" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true">
          <label class="sr" for="nlFoot">Subscribe to our newsletter</label>
          <input id="nlFoot" type="email" name="email" placeholder="Subscribe: your email" autocomplete="email" required>
          <button class="btn btn-orange btn-sm" type="submit" aria-label="Subscribe"><%- icon('arrow') %></button>
          <p class="nl-msg" role="status" hidden></p>
        </form>
        <% } %>
        <div class="socials">
          <% Object.entries(s.social || {}).filter(function(e){return e[1]}).forEach(function(e){ %>
            <a href="<%= e[1] %>" target="_blank" rel="noopener" aria-label="<%= e[0] %>"><%- icon(e[0]) %></a>
          <% }) %>
        </div>
      </div>
      <div>
        <h3>Services</h3>
        <ul><% navServices.slice(0, 10).forEach(function(sv){ %><li><a href="/services/<%= sv.slug %>"><%= sv.title %></a></li><% }) %></ul>
      </div>
      <div>
        <h3>Company</h3>
        <ul>
          <li><a href="/#about">About us</a></li>
          <li><a href="/portfolio">Portfolio</a></li>
          <li><a href="/industries">Industries</a></li>
          <% if (s.newsletter && s.newsletter.leadMagnetUrl) { %><li><a href="<%= s.newsletter.leadMagnetUrl %>">Free checklist</a></li><% } %>
          <li><a href="/#process">How we work</a></li>
          <li><a href="/blog">Blog</a></li>
          <li><a href="/#faq">FAQ</a></li>
        </ul>
      </div>
      <div>
        <h3>Get in touch</h3>
        <ul class="contact-list">
          <% if (s.email) { %><li><%- icon('mail') %><a href="mailto:<%= s.email %>"><%= s.email %></a></li><% } %>
          <% if (s.phone) { %><li><%- icon('phone') %><a href="tel:<%= s.phone.replace(/\s/g,'') %>"><%= s.phone %></a></li><% } %>
          <% if (s.address) { %><li><%- icon('pin') %><a href="https://www.google.com/maps/search/?api=1&query=<%= encodeURIComponent(s.address) %>" target="_blank" rel="noopener"><address><%= s.address %></address></a></li><% } %>
          <li><%- icon('globe') %><span>Serving clients worldwide</span></li>
        </ul>
        <button class="btn btn-ghost-light btn-sm" data-open-contact>Send us your idea</button>
      </div>
    </div>

    <div class="footer-bottom">
      <p>© <%= year %> <%= s.siteName %>. All rights reserved.<% if (s.rcNumber) { %> <span class="rc">RC <%= s.rcNumber %></span><% } %></p>
      <p class="tagline">Global Technology • Industrial Precision • Intelligent Transformation</p>
    </div>
  </div>
</footer>

<!-- Floating actions -->
<div class="fab-wrap">
  <% if (s.whatsapp) { %><a class="fab fab-wa" href="https://wa.me/<%= s.whatsapp.replace(/\D/g,'') %>" target="_blank" rel="noopener" aria-label="Chat on WhatsApp"><%- icon('whatsapp') %></a><% } %>
  <button class="fab" data-open-contact aria-label="Start a project"><%- icon('spark') %><span>Start a project</span></button>
  <a class="fab fab-top" href="#top" aria-label="Back to top"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 19V5M5 12l7-7 7 7"/></svg></a>
</div>

<!-- Contact / project brief modal -->
<div class="modal" id="contactModal" role="dialog" aria-modal="true" aria-labelledby="cmTitle" hidden>
  <div class="modal-backdrop" data-close></div>
  <div class="modal-panel">
    <button class="icon-btn modal-close" data-close aria-label="Close"><%- icon('close') %></button>
    <div class="modal-side">
      <img src="/img/logo-mark.webp" alt="" width="90" height="60" loading="lazy">
      <h2 id="cmTitle">Let’s build something great</h2>
      <p>Tell us about your idea. A senior consultant will get back to you within one business day.</p>
      <ul class="ticks">
        <li><%- icon('check') %> Free consultation</li>
        <li><%- icon('check') %> Ballpark estimate &amp; timeline</li>
        <li><%- icon('check') %> NDA available on request</li>
        <li><%- icon('check') %> No obligation</li>
      </ul>
      <% if (s.address) { %><p class="modal-addr"><%- icon('pin') %><span><%= s.address %><% if (s.rcNumber) { %><br><small>Registered in Nigeria · RC <%= s.rcNumber %></small><% } %></span></p><% } %>
      <% if (s.bookingUrl) { %><a class="btn btn-ghost-light btn-sm" href="<%= s.bookingUrl %>" target="_blank" rel="noopener"><%- icon('calendar') %> Prefer to book a call?</a><% } %>
    </div>

    <form class="brief" id="briefForm" novalidate>
      <div class="steps-bar"><span class="on"></span><span></span><span></span></div>
      <input type="text" name="website" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true">

      <fieldset class="step active" data-step="1">
        <legend>1. What can we help you with?</legend>
        <p class="hint">Select all that apply.</p>
        <div class="chips">
          <% navServices.forEach(function(sv){ %>
            <label class="chip"><input type="checkbox" name="services" value="<%= sv.title %>"><span><%- icon(sv.icon) %><%= sv.title %></span></label>
          <% }) %>
        </div>
        <p class="label">Project stage</p>
        <div class="chips chips-sm">
          <% ['New product / idea','Improve existing system','Consultation & strategy','Team training','Not sure yet'].forEach(function(t, i){ %>
            <label class="chip"><input type="radio" name="projectType" value="<%= t %>" <%= i===0?'checked':'' %>><span><%= t %></span></label>
          <% }) %>
        </div>
      </fieldset>

      <fieldset class="step" data-step="2">
        <legend>2. Tell us about your idea</legend>
        <label class="field"><span>Describe what you want to build *</span>
          <textarea name="idea" rows="5" required minlength="10" placeholder="e.g. A mobile app for our customers to track orders, pay online and chat with support. We also need an admin dashboard…"></textarea></label>
        <div class="row2">
          <label class="field"><span>Estimated budget</span>
            <select name="budget"><option value="">Select…</option><option>Under $5,000</option><option>$5,000 – $15,000</option><option>$15,000 – $50,000</option><option>$50,000 – $150,000</option><option>$150,000+</option><option>Not sure yet</option></select></label>
          <label class="field"><span>Timeline</span>
            <select name="timeline"><option value="">Select…</option><option>ASAP</option><option>Within 1 month</option><option>1 – 3 months</option><option>3 – 6 months</option><option>Flexible</option></select></label>
        </div>
      </fieldset>

      <fieldset class="step" data-step="3">
        <legend>3. How can we reach you?</legend>
        <div class="row2">
          <label class="field"><span>Full name *</span><input name="name" required autocomplete="name"></label>
          <label class="field"><span>Work email *</span><input name="email" type="email" required autocomplete="email"></label>
          <label class="field"><span>Phone / WhatsApp</span><input name="phone" type="tel" autocomplete="tel"></label>
          <label class="field"><span>Organisation</span><input name="company" autocomplete="organization"></label>
          <label class="field"><span>Country</span><input name="country" autocomplete="country-name"></label>
          <label class="field"><span>Preferred contact</span>
            <select name="contactPref"><option>Video meeting</option><option>Phone call</option><option>Email</option><option>WhatsApp</option></select></label>
        </div>
        <label class="field"><span>Best time for a meeting (optional)</span><input name="meetingTime" placeholder="e.g. Weekdays after 2pm WAT"></label>
        <label class="consent"><input type="checkbox" name="consent" required> <span>I agree that Reown may contact me about my enquiry.</span></label>
      </fieldset>

      <div class="step-done" hidden>
        <div class="done-ic"><%- icon('check') %></div>
        <h3>Thank you — we’ve received your idea!</h3>
        <p>Our team will review your brief and get back to you within one business day.</p>
        <a class="btn btn-primary" id="bookAfter" href="#" target="_blank" rel="noopener" hidden><%- icon('calendar') %> Book a meeting now</a>
      </div>

      <p class="form-error" role="alert" hidden></p>
      <div class="step-nav">
        <button type="button" class="btn btn-ghost" data-prev hidden>Back</button>
        <button type="button" class="btn btn-primary" data-next>Continue <%- icon('arrow') %></button>
        <button type="submit" class="btn btn-orange" data-submit hidden>Send my project brief</button>
      </div>
    </form>
  </div>
</div>

<script src="/js/site.js?v=1" defer></script>
</body>
</html>

<a class="pf-card reveal" style="--d:<%= (i % 3) * 80 %>ms" href="/portfolio/<%= p.slug %>" data-cat="<%= p.category %>">
  <%- include('cover', { item: p }) %>
  <div class="pf-body">
    <p class="meta"><span><%= p.industry %></span><span><%= p.category %></span></p>
    <h3><%= p.title %></h3>
    <p><%= p.summary %></p>
    <% if (p.results && p.results.length) { %>
      <div class="pf-results"><% p.results.slice(0,2).forEach(function(r){ %><span><strong><%= r.value %></strong> <%= r.label %></span><% }) %></div>
    <% } %>
    <span class="more">View case study <%- icon('arrow') %></span>
  </div>
</a>

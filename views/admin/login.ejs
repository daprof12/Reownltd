<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex, nofollow">
  <title>Sign in — Reown CMS</title>
  <link rel="icon" href="/img/logo-mark.webp">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Montserrat:wght@700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/admin.css?v=1">
</head>
<body class="login-body">
  <form class="login-card" method="post" action="/admin/login">
    <img src="/img/logo-full.webp" alt="Reown Ltd" width="220" height="73">
    <h1>Content Manager</h1>
    <p class="muted">Sign in to manage your website.</p>
    <% if (disabled) { %><p class="alert">Admin login is disabled. Set <code>ADMIN_PASSWORD</code> in your environment.</p><% } %>
    <% if (error) { %><p class="alert"><%= error %></p><% } %>
    <label>Username<input name="username" autocomplete="username" required autofocus></label>
    <label>Password<input name="password" type="password" autocomplete="current-password" required></label>
    <button class="btn btn-primary" <%= disabled ? 'disabled' : '' %>>Sign in</button>
    <a href="/" class="muted small">← Back to website</a>
  </form>
</body>
</html>
